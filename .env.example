# ── Existing ──────────────────────────────────────────────────────────────────
GROQ_API_KEY=xxxxxxxx
SARVAM_API_KEY=xxxxxxxx
# Gemini API key (voice LLM). Free at https://aistudio.google.com/apikey —
# keep it on a project WITHOUT billing so the free tier stays active.
GEMINI_API_KEY=xxxxxxxx
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# ── Phase 1: Qdrant Cloud (https://cloud.qdrant.io — free tier, no credit card) ──
QDRANT_URL=https://xxxx.us-east4-0.gcp.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key

# ── Phase 4: LangSmith observability (https://smith.langchain.com) ────────────
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=DreamSupport

# ── LLM models (voice + dream on separate providers) ──────────────────────────
# Voice → Gemini Flash-Lite (fast first token, strong Indian-language voice).
# Dream → Groq gpt-oss-120b (reasoning model; an asset for offline analysis).
VOICE_LLM_MODEL=gemini-3.1-flash-lite

# ── Phase 5: Dream Engine ─────────────────────────────────────────────────────
DREAM_LLM_MODEL=openai/gpt-oss-120b
DREAM_IDLE_THRESHOLD_SECS=30
DREAM_CYCLE_INTERVAL_SECS=60
# Dreaming no longer shares a budget with voice → full gpt-oss-120b free-tier
# day (~200K tokens). Safety ceiling only; Groq's 429 is the real backstop.
DREAM_DAILY_TOKEN_BUDGET=200000

# ── Sarvam speech models (migrate versions here, not in code) ─────────────────
# STT: saaras:v3 recommended (saarika:v2.5 is legacy/deprecated). SARVAM_STT_MODE
# applies only to saaras:* — "transcribe" keeps the caller's language,
# "translate" forces English.
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_MODE=transcribe
# TTS: bulbul:v3. Speaker MUST be valid for the chosen model — bulbul:v3 rejects
# v2 speakers like "anushka". Valid v3: simran, priya, neha, ritu, pooja, shubh…
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=simran

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_DIM=768
EMBEDDING_PROVIDER=local       # "local" uses sentence-transformers (free, CPU)
                               # "openai" uses text-embedding-3-small (paid)
# OPENAI_API_KEY=              # only needed if EMBEDDING_PROVIDER=openai
