GROQ_API_KEY=
SARVAM_API_KEY=
# Gemini API key (voice LLM). Get one free at https://aistudio.google.com/apikey
# — keep it on a project WITHOUT billing so the free tier stays active.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
QDRANT_URL=
QDRANT_API_KEY=

# LangSmith Observability
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=DreamSupport

# LLM models — voice and dream run on SEPARATE providers (independent free-tier
# pools, so dreaming can never starve the live voice path).
#   Voice → Gemini Flash-Lite (fast first token, strong Indian-language voice).
#   Dream → Groq gpt-oss-120b (reasoning model; an asset for offline analysis).
VOICE_LLM_MODEL=gemini-3.1-flash-lite
DREAM_LLM_MODEL=openai/gpt-oss-120b

# Dream Engine
DREAM_IDLE_THRESHOLD_SECS=300
DREAM_CYCLE_INTERVAL_SECS=300
# Hard daily token cap for dreaming. Now that dreaming (Groq) no longer shares a
# budget with voice (Gemini), it gets the FULL gpt-oss-120b free-tier day
# (~200K tokens). Safety ceiling only — Groq's own 429 is the real backstop.
DREAM_DAILY_TOKEN_BUDGET=200000

# Sarvam speech models — change the version here, no code changes needed.
# STT: saaras:v3 (saarika:v2.5 is legacy). SARVAM_STT_MODE applies only to
# saaras:* (transcribe = keep original language; translate = force English).
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_MODE=transcribe
# TTS: bulbul:v3. Speaker MUST be a bulbul:v3 speaker (v2 names like "anushka"
# are rejected). Valid v3: simran, priya, neha, ritu, pooja, kavya, shubh, …
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=simran

# Embeddings
EMBEDDING_DIM=384
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=intfloat/multilingual-e5-small
